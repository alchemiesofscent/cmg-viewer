{
  "name": "cmg-viewer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Static catalogue and IIIF viewer for the BBAW CMG/CML digital editions",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "sync": "node scripts/python.mjs scripts/sync_full.py",
    "sync:samples": "node scripts/python.mjs scripts/sync.py --scope samples",
    "build": "node scripts/python.mjs scripts/build.py",
    "validate": "node scripts/python.mjs scripts/validate.py",
    "test": "node scripts/test.mjs",
    "serve": "node scripts/python.mjs scripts/serve.py --port 8000",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "tify": "0.35.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
